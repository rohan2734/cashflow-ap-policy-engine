# ─── App Database ────────────────────────────────────────────────────────────
POSTGRES_USER=cashflo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cashflo

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "nvidia" or "bedrock"
LLM_PROVIDER=nvidia

# NVIDIA NIM / build.nvidia.com API key
NVIDIA_API_KEY=

# AWS Bedrock credentials (only needed when LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── Ports ───────────────────────────────────────────────────────────────────
UI_PORT=3000
API_PORT=8000
LANGFUSE_PORT=3005
POSTGRES_PORT=5432
LANGFUSE_POSTGRES_PORT=5433

# ─── Langfuse ────────────────────────────────────────────────────────────────
# After first docker compose up, open http://localhost:${LANGFUSE_PORT}, create an org +
# project, then copy the generated keys here and restart.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Langfuse internal database password (choose any strong password)
LANGFUSE_DB_PASSWORD=changeme-langfuse

# Langfuse auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL where Langfuse UI is reachable (change in production)
NEXTAUTH_URL=http://localhost:3005

# Langfuse hashing salt — generate with: openssl rand -base64 32
SALT=
